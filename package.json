{
  "name": "ai-voice-control",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n \"web,agent\" -c \"cyan,green\" \"next dev --turbopack -p 3000\" \"py agent/agent.py dev\"",
    "dev:6000": "concurrently -n \"web,agent\" -c \"cyan,green\" \"next dev --turbopack -p 6000\" \"py agent/agent.py dev\"",
    "dev:electron": "concurrently -n \"web,agent,electron\" -c \"cyan,green,magenta\" \"next dev --turbopack -p 6000\" \"py agent/agent.py dev\" \"wait-on http-get://localhost:6000 && electron .\"",
    "dev:frontend": "next dev --turbopack -p 6000",
    "desktop": "electron .",
    "electron": "electron .",
    "electron:pack": "node scripts/build_electron.js --dir",
    "electron:dist": "node scripts/build_electron.js --win",
    "agent": "py agent/agent.py dev",
    "agent:install": "py -m pip install -r agent/requirements.txt",
    "build": "next build",
    "start": "next start -p 6000",
    "start:6000": "next start -p 6000",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shadcn:install": "pnpm dlx shadcn@latest add --yes @agents-ui/all && pnpm format"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.20",
    "@livekit/krisp-noise-filter": "^0.4.4",
    "@livekit/protocol": "^1.41.0",
    "@phosphor-icons/react": "^2.1.8",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.26.1",
    "@shadcn/react": "^0.2.1",
    "@xyflow/react": "^12.10.0",
    "ai": "^5.0.105",
    "buffer-image-size": "^0.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "jose": "^6.0.12",
    "livekit-client": "^2.17.2",
    "livekit-server-sdk": "^2.13.3",
    "lucide-react": "^0.555.0",
    "media-chrome": "^4.17.2",
    "mime": "^4.0.7",
    "motion": "^12.16.0",
    "nanoid": "^5.1.6",
    "next": "15.5.18",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^3.21.0",
    "sonner": "^2.0.7",
    "streamdown": "^1.6.9",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "electron": "^40.10.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@9.15.9"
}
